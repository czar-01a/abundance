# Security headers for every page (read by Cloudflare when it serves the site; not served as a file)
# cloudflareinsights.com is Cloudflare Web Analytics (free, cookie-free visitor stats). Remove both entries if you turn it off.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

# Fonts never change under the same name: cache them for a year
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Logos and icons: cache for a year. If you change one, save it under a new file name
# (e.g. logo-92-v2.webp) and update the pages, so visitors get the new one right away.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The private area should never be indexed or cached by shared caches
/insiders/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: private, no-store
