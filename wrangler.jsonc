// Cloudflare settings for the Abundance site.
// The Worker serves the static site and emails form submissions (see worker/index.js).
{
  "name": "WORKER_NAME",             // must match the Worker's name in the Cloudflare dashboard
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "send_email": [
    { "name": "FORMS", "destination_address": "INBOX_ADDRESS" }
  ],
  "vars": {
    "FORMS_TO": "INBOX_ADDRESS"
  }
}
